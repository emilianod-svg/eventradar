# ============================================================================
# EventRadar — variables de entorno de ejemplo
# ============================================================================
# Copiar a `.env` (NUNCA versionar `.env`) y completar con valores reales.
# Ningún valor de este archivo es un secreto real ni una URL de proveedor
# confirmada: son placeholders documentados (regla obligatoria del prompt de
# inicialización).
# ============================================================================

# --- Identidad de la aplicación ---
APP_NAME=eventradar-backend
ENVIRONMENT=local          # local | test | staging | production
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eventradar
POSTGRES_USER=eventradar
POSTGRES_PASSWORD=change-me-local-only
# Si se define, tiene prioridad sobre los POSTGRES_* individuales.
DATABASE_URL=postgres://eventradar:change-me-local-only@localhost:5433/eventradar

# --- CORS ---
# Lista separada por comas. NUNCA "*" en producción.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- URLs públicas ---
BACKEND_PUBLIC_URL=http://localhost:8000
FRONTEND_PUBLIC_URL=http://localhost:5173
# Leída por el frontend (Vite) en build-time.
VITE_API_URL=http://localhost:8000

# --- Seguridad interna (endpoints /api/v1/internal/*) ---
ADMIN_API_KEY=change-me-generate-a-long-random-value

# --- Zona horaria y scheduler ---
TIMEZONE=America/Argentina/Cordoba
SCHEDULER_ENABLED=false
# Cron por defecto: lunes y viernes a las 09:00 (sección 13 del plan).
SCHEDULER_CRON=0 9 * * 1,5

# --- Geografía base (Posadas, Misiones) ---
BASE_LATITUDE=-27.3671
BASE_LONGITUDE=-55.8961
SEARCH_RADIUS_KM=15

# --- LLM (sección 3.1 y 9 del plan) ---
# Proveedor/modelo usados para desarrollo y smoke tests reales. La decisión
# original (sección 1.2 del doc de decisiones) fue "Llama" como familia
# open source; minimax-m3:cloud es un modelo distinto servido vía el proxy
# cloud de Ollama, elegido pragmáticamente porque ya funciona sin más setup.
# Si el equipo quiere volver a un Llama local: `ollama pull llama3.1` (u
# otro tag) y actualizar LLM_MODEL.
LLM_PROVIDER=ollama
LLM_MODEL=minimax-m3:cloud
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1

# --- OCR (Google Vision API) ---
OCR_ENABLED=false
# Ruta a un archivo de credenciales de servicio (NO el JSON en texto plano).
GOOGLE_VISION_CREDENTIALS_JSON=

# --- Geocodificación (Nominatim / OpenStreetMap) ---
NOMINATIM_ENABLED=true
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=EventRadar/0.1 (contacto pendiente)
# Requerido por la política de uso de Nominatim antes de habilitar consultas.
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_RATE_LIMIT_SECONDS=1

# --- Geocodificación free tier / fallback ---
LOCATIONIQ_ENABLED=false
LOCATIONIQ_API_KEY=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1

GEOAPIFY_ENABLED=false
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1

GEOCODING_PROVIDER_ORDER=nominatim,locationiq,geoapify
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_CACHE_TTL_SECONDS=2592000
GEOCODING_NEGATIVE_CACHE_TTL_SECONDS=3600

GEO_CONFIDENCE_REJECT_THRESHOLD=0.50
GEO_CONFIDENCE_REVIEW_THRESHOLD=0.75
GEO_CONFIDENCE_AUTO_THRESHOLD=0.90

# Opcional: bounding box geográfico para forzar alcance permitido.
# GEO_ALLOWED_MIN_LATITUDE=
# GEO_ALLOWED_MAX_LATITUDE=
# GEO_ALLOWED_MIN_LONGITUDE=
# GEO_ALLOWED_MAX_LONGITUDE=

# --- Presupuesto y límites de IA ---
AI_MONTHLY_BUDGET_USD=20

# --- Flags experimentales ---
ENABLE_EXPERIMENTAL_ADAPTERS=false
# Desactivado hasta cerrar la estrategia de la sección 3.2 del plan.
ENABLE_FACEBOOK_ADAPTER=false
